# Use absolute paths; generate the token locally, do not commit it.
CS16_LISTEN=127.0.0.1:27016
CS16_ADMIN_LISTEN=127.0.0.1:27017
CS16_ADMIN_TOKEN_FILE=/opt/winlife-cs16/admin-token
CS16_ENGINE=/opt/winlife-cs16/engine/xash
CS16_GAME_DIR=/opt/winlife-cs16/game
CS16_PUBLIC=/opt/winlife-cs16/public
CS16_MAX_ROOMS=4
CS16_CLIENT_TRANSPORT=websocket
# For WebRTC deployments, use webrtc and configure routable UDP ports / HTTPS.
# CS16_PUBLIC_IP=203.0.113.10
