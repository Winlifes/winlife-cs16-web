+void WinlifeRememberPurchasedPrimary(CBasePlayer *p, CBaseEntity *purchased) {
+    if (!individualMode() || !purchased)
+        return;
+    auto *l = ledger(p);
+    const auto *primary = p->m_rgpPlayerItems[PRIMARY_WEAPON_SLOT];
+    if (!l || primary != purchased)
+        return;
+
+    const int user = GETPLAYERUSERID(p->edict());
+    if (user > 0) {
+        l->spawnUser = user;
+        l->spawnPrimary = static_cast<WeaponIdType>(primary->m_iId);
+    }
+}
+
+const WeaponInfoStruct *WinlifeRespawnPrimary(CBasePlayer *p) {
+    const auto weapon = spawnPrimary(p, GETPLAYERUSERID(p->edict()));
+    if (weapon == WEAPON_NONE)
+        return nullptr;
+    const auto item = GetItemIdByWeaponId(weapon);
+    if (item == ITEM_NONE || !IsPrimaryWeapon(item) || p->HasRestrictItem(item, ITEM_TYPE_EQUIPPED))
+        return nullptr;
+
+    const auto *info = GetWeaponInfo(weapon);
+    return info && info->entityName ? info : nullptr;
+}
