 CBaseEntity *g_pLastCTSpawn;
 CBaseEntity *g_pLastTerroristSpawn;
 
+#ifdef REGAMEDLL_ADD
+static CBaseEntity *ChooseIndividualSpawn(CBasePlayer *player, bool useTeamStarts)
+{
+	const char *types[] = {"info_spawn_point", "info_player_start", "info_player_deathmatch"};
+	CBaseEntity *chosen = nullptr;
+	int bestPriority = -1;
+	int count = 0;
+	for (int i = useTeamStarts ? 1 : 0; i < (useTeamStarts ? 3 : 1); ++i)
+	{
+		// YaPB creates these points through the engine after map activation.
+		edict_t *entity = nullptr;
+		while (!FNullEnt(entity = FIND_ENTITY_BY_CLASSNAME(entity, types[i])))
+		{
+			CBaseEntity *spot = CBaseEntity::Instance(entity);
+			if (!spot || spot->pev->origin == g_vecZero || !IsSpawnPointValid(player, spot, 64.0f))
+				continue;
+
+			const Vector origin = spot->pev->origin + Vector(0, 0, 1);
+			TraceResult trace;
+			UTIL_TraceHull(origin, origin, dont_ignore_monsters, human_hull, player->edict(), &trace);
+			if (trace.fStartSolid || trace.fAllSolid || UTIL_PointContents(origin) != CONTENTS_EMPTY)
+				continue;
+
+			// Prefer points away from living players and avoid immediate repeats.
+			const bool distant = IsSpawnPointValid(player, spot, 384.0f);
+			const int priority = (distant ? 2 : 0) + (spot != g_pLastSpawn ? 1 : 0);
+			if (priority < bestPriority)
+				continue;
+			if (priority > bestPriority)
+			{
+				bestPriority = priority;
+				count = 0;
+			}
+			if (RANDOM_LONG(1, ++count) == 1)
+				chosen = spot;
+		}
+	}
+	return chosen;
+}
+#endif
