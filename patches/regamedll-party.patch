diff --git a/regamedll/dlls/winlife_party.cpp b/regamedll/dlls/winlife_party.cpp
new file mode 100644
index 0000000..cf8c8b2
--- /dev/null
+++ b/regamedll/dlls/winlife_party.cpp
@@ -0,0 +1,258 @@
+#include "precompiled.h"
+#include "winlife_party.h"
+#include <vector>
+
+namespace {
+enum class Mode { Off, Infection, Hide };
+enum class Phase { Waiting, Prep, Live, Between, Finished };
+
+cvar_t partyMode = { "winlife_party_mode", "0", FCVAR_SERVER, 0, nullptr };
+cvar_t startPlayers = { "winlife_party_start_players", "2", FCVAR_SERVER, 0, nullptr };
+Phase phase = Phase::Waiting;
+int roundNumber = 1;
+float deadline = 0;
+float nextCheck = 0;
+float joinDeadline = 0;
+bool initialRound = true;
+
+Mode mode()
+{
+    if (partyMode.value == 1) return Mode::Infection;
+    if (partyMode.value == 2) return Mode::Hide;
+    return Mode::Off;
+}
+
+bool playing(CBasePlayer *player)
+{
+    return player && !player->IsDormant() && player->m_iJoiningState == JOINED &&
+        (player->m_iTeam == CT || player->m_iTeam == TERRORIST);
+}
+
+std::vector<CBasePlayer *> players()
+{
+    std::vector<CBasePlayer *> result;
+    for (int i = 1; i <= gpGlobals->maxClients; ++i)
+    {
+        CBasePlayer *player = UTIL_PlayerByIndex(i);
+        if (playing(player)) result.push_back(player);
+    }
+    return result;
+}
+
+void report(const char *stage, int seconds = 0, int winner = 0)
+{
+    UTIL_LogPrintf("WINLIFE_PARTY 1 %s %d %d %d\n", stage, roundNumber, seconds, winner);
+}
+
+void releasePlayers(const std::vector<CBasePlayer *> &list)
+{
+    for (CBasePlayer *player : list)
+    {
+        player->ResetMaxSpeed();
+        if (mode() == Mode::Hide && player->m_iTeam == CT)
+            UTIL_ScreenFade(player, Vector(0, 0, 0), 0.1f, 0, 0, FFADE_IN);
+    }
+}
+
+void equip(CBasePlayer *player)
+{
+    player->RemoveAllItems(FALSE);
+    player->pev->armorvalue = 0;
+    player->m_iKevlar = ARMOR_NONE;
+    player->GiveNamedItem("weapon_knife");
+    if (mode() == Mode::Infection && player->m_iTeam == CT)
+    {
+        player->GiveNamedItem("weapon_mp5navy");
+        player->GiveAmmo(90, "9mm", 120);
+    }
+    const float health = mode() == Mode::Infection && player->m_iTeam == TERRORIST ? 220.0f : 100.0f;
+    player->pev->max_health = health;
+    player->pev->health = health;
+    player->ResetMaxSpeed();
+}
+
+void beginRound(const std::vector<CBasePlayer *> &list)
+{
+    const bool infection = mode() == Mode::Infection;
+    CBasePlayer *seed = infection ? list[RANDOM_LONG(0, static_cast<int>(list.size()) - 1)] : nullptr;
+    const int prepTime = infection ? 6 : 12;
+    initialRound = false;
+    phase = Phase::Prep;
+    deadline = gpGlobals->time + prepTime;
+    for (CBasePlayer *player : list)
+    {
+        if (infection)
+        {
+            const auto team = player == seed ? TERRORIST : CT;
+            if (player->m_iTeam != team) player->SwitchTeam();
+        }
+        else if (roundNumber == 2)
+            player->SwitchTeam();
+        player->RemoveAllItems(FALSE);
+        player->m_bNotKilled = false;
+        player->RoundRespawn();
+        equip(player);
+        if (mode() == Mode::Hide && player->m_iTeam == CT)
+            UTIL_ScreenFade(player, Vector(0, 0, 0), 0.1f, prepTime, 255, FFADE_OUT | FFADE_STAYOUT);
+    }
+    report("prep", prepTime);
+}
+
+void finishRound(int winner)
+{
+    UTIL_LogPrintf("World triggered \"Round_End\"\n");
+    if (mode() == Mode::Hide && roundNumber == 1)
+    {
+        phase = Phase::Between;
+        deadline = gpGlobals->time + 4;
+        report("between", 4, winner);
+    }
+    else
+    {
+        phase = Phase::Finished;
+        report("finish", 0, winner);
+    }
+}
+
+void clearRound()
+{
+    phase = Phase::Waiting;
+    roundNumber = 1;
+    deadline = 0;
+    nextCheck = 0;
+    joinDeadline = 0;
+}
+
+void resetMatch()
+{
+    if (!WinlifePartyEnabled()) return;
+    clearRound();
+    releasePlayers(players());
+    report("wait");
+}
+}
+
+void WinlifePartyRegister()
+{
+    CVAR_REGISTER(&partyMode);
+    CVAR_REGISTER(&startPlayers);
+    ADD_SERVER_COMMAND("winlife_party_reset", resetMatch);
+}
+
+void WinlifePartyMapReset()
+{
+    clearRound();
+    initialRound = true;
+}
+
+bool WinlifePartyEnabled() { return mode() != Mode::Off; }
+
+bool WinlifePartyFrozen(CBasePlayer *player)
+{
+    if (!WinlifePartyEnabled() || phase != Phase::Prep || !playing(player)) return false;
+    return player->m_iTeam == (mode() == Mode::Hide ? CT : TERRORIST);
+}
+
+bool WinlifePartyAllowTeam(CBasePlayer *player, int slot)
+{
+    if (!WinlifePartyEnabled() || phase == Phase::Waiting || slot == MENU_SLOT_TEAM_SPECT) return true;
+    return playing(player) && slot == player->m_iTeam;
+}
+
+bool WinlifePartyAllowItem(CBasePlayer *player, int weapon)
+{
+    return !WinlifePartyEnabled() || weapon == WEAPON_KNIFE ||
+        (mode() == Mode::Infection && player->m_iTeam == CT && weapon == WEAPON_MP5N);
+}
+
+void WinlifePartyInput(CBasePlayer *player)
+{
+    if (!WinlifePartyEnabled() || !playing(player)) return;
+    if (phase != Phase::Live || (mode() == Mode::Hide && player->m_iTeam == TERRORIST))
+        player->pev->button &= ~(IN_ATTACK | IN_ATTACK2);
+    if (WinlifePartyFrozen(player)) player->pev->velocity = g_vecZero;
+}
+
+bool WinlifePartyIntercept(CBasePlayer *victim, entvars_t *inflictor, entvars_t *attacker, float &damage)
+{
+    if (!WinlifePartyEnabled() || !playing(victim)) return false;
+    if (phase != Phase::Live) return true;
+    CBaseEntity *entity = attacker ? CBaseEntity::Instance(attacker) : nullptr;
+    if (!entity || !entity->IsPlayer() || entity == victim) return false;
+    auto *source = static_cast<CBasePlayer *>(entity);
+    if (!playing(source) || source->m_iTeam == victim->m_iTeam) return true;
+    const bool knife = inflictor == attacker && source->m_pActiveItem && source->m_pActiveItem->m_iId == WEAPON_KNIFE;
+    if (mode() == Mode::Hide)
+    {
+        if (source->m_iTeam != CT || !knife || damage <= 0) return true;
+        damage = victim->pev->health + 100;
+        return false;
+    }
+    if (source->m_iTeam != TERRORIST) return false;
+    if (knife && damage > 0 && victim->IsAlive())
+    {
+        victim->SwitchTeam();
+        equip(victim);
+        UTIL_LogPrintf("WINLIFE_PARTY_CONVERT 1 %d %d\n", GETPLAYERUSERID(source->edict()), GETPLAYERUSERID(victim->edict()));
+    }
+    return true;
+}
+
+void WinlifePartyFrame()
+{
+    if (!WinlifePartyEnabled() || phase == Phase::Finished || gpGlobals->time < nextCheck) return;
+    nextCheck = gpGlobals->time + 0.1f;
+    auto list = players();
+    if (list.size() < 2)
+    {
+        if (phase != Phase::Waiting) resetMatch();
+        return;
+    }
+    if (phase == Phase::Waiting)
+    {
+        bool hasT = false, hasCT = false;
+        for (CBasePlayer *player : list)
+        {
+            hasT = hasT || player->m_iTeam == TERRORIST;
+            hasCT = hasCT || player->m_iTeam == CT;
+        }
+        if (mode() == Mode::Hide && !(hasT && hasCT)) return;
+        // Lobby members may finish downloading the browser assets at different
+        // times. Give them time to choose a side before locking the first round.
+        if (initialRound && static_cast<int>(list.size()) < startPlayers.value)
+        {
+            if (joinDeadline == 0) joinDeadline = gpGlobals->time + 25;
+            if (gpGlobals->time < joinDeadline) return;
+        }
+        beginRound(list);
+        return;
+    }
+    if (phase == Phase::Between && gpGlobals->time >= deadline)
+    {
+        ++roundNumber;
+        beginRound(list);
+        return;
+    }
+    if (phase == Phase::Prep && gpGlobals->time >= deadline)
+    {
+        const int seconds = mode() == Mode::Infection ? 100 : 75;
+        phase = Phase::Live;
+        deadline = gpGlobals->time + seconds;
+        releasePlayers(list);
+        UTIL_LogPrintf("World triggered \"Round_Start\"\n");
+        report("live", seconds);
+        return;
+    }
+    if (phase != Phase::Live) return;
+    bool liveT = false, liveCT = false;
+    for (CBasePlayer *player : list)
+    {
+        if (!player->IsAlive()) continue;
+        liveT = liveT || player->m_iTeam == TERRORIST;
+        liveCT = liveCT || player->m_iTeam == CT;
+    }
+    if (!liveT || !liveCT)
+        finishRound(liveT ? TERRORIST : liveCT ? CT : 0);
+    else if (gpGlobals->time >= deadline)
+        finishRound(mode() == Mode::Infection ? CT : TERRORIST);
+}
