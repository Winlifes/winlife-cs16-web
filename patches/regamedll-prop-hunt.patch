+struct PropSpec
+{
+    const char *model;
+    float lift;
+};
+// These models are already in the game data. Lift accounts for each model's origin.
+constexpr PropSpec propSpecs[] = {
+    { "models/pallet_with_bags.mdl", 22.4f },
+    { "models/bush.mdl", 32.f },
+    { "models/big_rock.mdl", 1.f },
+    { "models/filecabinet.mdl", 0.f },
+    { "models/uplant2.mdl", 0.f },
+};
+constexpr int propCount = sizeof(propSpecs) / sizeof(propSpecs[0]);
+struct Disguise
+{
+    EHANDLE entity;
+    int choice = 0;
+};
+std::array<Disguise, MAX_CLIENTS + 1> disguises;
+int availableProps = 0;
+
 Mode mode()
 {
     if (partyMode.value == 1) return Mode::Infection;
@@ -28,6 +52,80 @@ bool playing(CBasePlayer *player)
         (player->m_iTeam == CT || player->m_iTeam == TERRORIST);
 }
 
+bool hiding(CBasePlayer *player)
+{
+    return mode() == Mode::Hide && (phase == Phase::Prep || phase == Phase::Live)
+        && playing(player) && player->m_iTeam == TERRORIST && player->IsAlive();
+}
+
+Disguise &disguiseOf(CBasePlayer *player)
+{
+    return disguises[player->entindex()];
+}
+
+void showProp(CBasePlayer *player, int choice)
+{
+    char message[64];
+    Q_snprintf(message, sizeof(message), "WINLIFE_PROP 1 %d %d\n", choice, availableProps);
+    ClientPrint(player->pev, HUD_PRINTCONSOLE, message);
+}
+
+void removeProp(Disguise &disguise)
+{
+    if (CBaseEntity *entity = disguise.entity)
+    {
+        entity->pev->effects |= EF_NODRAW;
+        UTIL_Remove(entity);
+    }
+    disguise = Disguise{};
+}
+
+void clearProps()
+{
+    if (mode() != Mode::Hide) return;
+    for (auto &disguise : disguises) removeProp(disguise);
+}
+
+void updateProp(CBasePlayer *player, CBaseEntity *entity, int choice)
+{
+    const auto *pev = player->pev;
+    const Vector origin = pev->origin + Vector(0, 0, pev->mins.z + propSpecs[choice - 1].lift + 1.f);
+    if (entity->pev->origin != origin)
+        UTIL_SetOrigin(entity->pev, origin);
+    if (pev->velocity.Length2D() > 20.f)
+        entity->pev->angles.y = pev->v_angle.y;
+}
+
+void applyProp(CBasePlayer *player, int choice)
+{
+    auto &disguise = disguiseOf(player);
+    CBaseEntity *entity = disguise.entity;
+    if (!entity)
+    {
+        entity = CBaseEntity::Create("info_target", player->pev->origin, g_vecZero, player->edict());
+        if (!entity) return;
+        entity->pev->effects |= EF_OWNER_NO_VISIBILITY;
+        entity->pev->framerate = 0;
+        disguise.entity = entity;
+    }
+    SET_MODEL(entity->edict(), propSpecs[choice - 1].model);
+    entity->pev->angles.y = player->pev->v_angle.y;
+    disguise.choice = choice;
+    updateProp(player, entity, choice);
+    showProp(player, choice);
+}
+
+void chooseStartingProp(CBasePlayer *player)
+{
+    int choice = 0, seen = 0;
+    for (int i = 0; i < propCount; ++i)
+    {
+        if ((availableProps & (1 << i)) && RANDOM_LONG(1, ++seen) == 1)
+            choice = i + 1;
+    }
+    if (choice) applyProp(player, choice);
+}
+
