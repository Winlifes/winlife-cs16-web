     if (!WinlifePartyEnabled()) return;
+    clearProps();
     clearRound();
     releasePlayers(players());
     report("wait");
@@ -139,10 +243,81 @@ void WinlifePartyRegister()
     ADD_SERVER_COMMAND("winlife_party_reset", resetMatch);
 }
 
+void WinlifePartyPrecache()
+{
+    // The room's ordinary config runs after the initial world loads.
+    const char *roomMode = std::getenv("CS16_MODE");
+    availableProps = 0;
+    disguises = {};
+    if (mode() != Mode::Hide && (!roomMode || !FStrEq(roomMode, "hide"))) return;
+    for (int i = 0; i < propCount; ++i)
+    {
+        const char *model = propSpecs[i].model;
+        if (GET_FILE_SIZE(model) > 0 && PRECACHE_MODEL(model) > 0)
+            availableProps |= 1 << i;
+    }
+}
+
+bool WinlifePartyIsDisguised(CBasePlayer *player)
+{
+    return hiding(player) && disguiseOf(player).entity.IsValid();
+}
+
+void WinlifePartyClearDisguise(CBasePlayer *player, bool notify)
+{
+    if (mode() != Mode::Hide || !player) return;
+    auto &disguise = disguiseOf(player);
+    if (!disguise.choice) return;
+    removeProp(disguise);
+    if (notify) showProp(player, 0);
+}
+
+void WinlifePartyUpdateDisguise(CBasePlayer *player)
+{
+    if (mode() != Mode::Hide) return;
+    auto &disguise = disguiseOf(player);
+    if (!disguise.choice) return;
+    if (!hiding(player))
+    {
+        WinlifePartyClearDisguise(player, true);
+        return;
+    }
+    if (CBaseEntity *entity = disguise.entity)
+        updateProp(player, entity, disguise.choice);
+}
+
+bool WinlifePartyPropCommand(CBasePlayer *player, const char *command, const char *arg)
+{
+    if (!FStrEq(command, "winlife_prop")) return false;
+    if (!hiding(player) || phase != Phase::Prep || !arg || Q_strlen(arg) != 1) return true;
+    const int choice = arg[0] - '1';
+    if (choice >= 0 && choice < propCount && (availableProps & (1 << choice)))
+        applyProp(player, choice + 1);
+    return true;
+}
+
 void WinlifePartyMapReset()
 {
     clearRound();
     initialRound = true;
+    if (!availableProps) return;
+
+    // The dedicated maps mark their static copies with the same model catalog.
+    CBaseEntity *decoy = nullptr;
+    while ((decoy = UTIL_FindEntityByTargetname(decoy, "winlife_hide_prop")))
+    {
+        if (!FClassnameIs(decoy->pev, "info_target")) continue;
+        for (int i = 0; i < propCount; ++i)
+        {
+            if (!(availableProps & (1 << i)) || !FStrEq(STRING(decoy->pev->model), propSpecs[i].model))
+                continue;
+            if (!decoy->pev->modelindex)
+                UTIL_SetOrigin(decoy->pev, decoy->pev->origin + Vector(0, 0, propSpecs[i].lift + 1.f));
+            SET_MODEL(decoy->edict(), propSpecs[i].model);
+            decoy->pev->framerate = 0;
+            break;
+        }
+    }
 }
 
 bool WinlifePartyEnabled() { return mode() != Mode::Off; }
@@ -161,6 +336,8 @@ bool WinlifePartyAllowTeam(CBasePlayer *player, int slot)
 
 bool WinlifePartyAllowItem(CBasePlayer *player, int weapon)
 {
+    if (mode() == Mode::Hide && availableProps && player->m_iTeam == TERRORIST)
+        return false;
     return !WinlifePartyEnabled() || weapon == WEAPON_KNIFE ||
         (mode() == Mode::Infection && player->m_iTeam == CT && weapon == WEAPON_MP5N);
 }
