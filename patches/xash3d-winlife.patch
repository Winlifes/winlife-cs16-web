+// Console-only desired pause state. Remote clients cannot invoke this through
+// SV_ExecuteClientCommand. Match settlement keeps networking/admin alive.
+static void SV_WinlifePause_f( void )
+{
+    if( Cmd_Argc() != 2 || sv.state != ss_active ) return;
+    qboolean desired = Q_atoi( Cmd_Argv( 1 )) != 0;
+    sv.match_settled = desired;
+    if( sv.paused != desired ) SV_TogglePause( desired ? "Match settled." : "New match starting." );
+}
+
 void SV_InitOperatorCommands( void )
 {
 	Cmd_AddCommand( "heartbeat", SV_Heartbeat_f, "send a heartbeat to the master server" );
