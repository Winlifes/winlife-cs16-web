+#if XASH_DEDICATED
+	Cmd_AddCommand( "kickendpoint", SV_KickEndpoint_f, "release the player belonging to a gateway UDP endpoint" );
+	Cmd_AddCommand( "winlife_pause", SV_WinlifePause_f, "set match settlement pause state" );
+#endif
 	Cmd_AddCommand( "status", SV_Status_f, "print server status information" );
 	Cmd_AddCommand( "status2", SV_Status2_f, "print verbose server status information" );
 	Cmd_AddCommand( "stat", SV_StatusFormatted_f, "print server status information, tab-separated" );
@@ -1349,6 +1382,10 @@ void SV_KillOperatorCommands( void )
 {
 	Cmd_RemoveCommand( "heartbeat" );
