@@ -568,6 +568,25 @@ SV_Kick_f
 Kick a user off of the server
 ==================
 */
+#if XASH_DEDICATED
+// The WebRTC gateway owns a unique local UDP endpoint per browser. Release
+// that player's slot as soon as its transport closes, including on page reload.
+static void SV_KickEndpoint_f( void )
+{
+	if( Cmd_Argc() != 2 )
+		return;
+	for( int i = 0; i < svs.maxclients; i++ )
+	{
+		sv_client_t *cl = &svs.clients[i];
+		if( cl->state >= cs_connected && !Q_strcmp( NET_AdrToString( cl->netchan.remote_address ), Cmd_Argv( 1 )))
+		{
+			SV_KickPlayer( cl, "WebRTC connection closed" );
+			return;
+		}
+	}
+}
+#endif
+
 static void SV_Kick_f( void )
 {
 	sv_client_t	*cl;
